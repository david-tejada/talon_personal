tag(): user.cursorless_use_community_snippets

settings():
  speech.timeout = 0.5
  user.screenshot_folder = "/Users/david/pictures/screenshots"
  user.subtitles_show = true
  user.subtitles_size = 30
  user.subtitles_timeout_min = 5000
  user.subtitles_timeout_max = 10000
  user.subtitles_y = 0.07

  # talon-ai-tools
  user.model_endpoint = "llm"
  # If the llm binary is not found on Talon's PATH, uncomment and set:
  user.model_llm_path = "/opt/homebrew/bin/llm"
